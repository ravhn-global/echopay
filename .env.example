ENV=local
LOG_LEVEL=debug
HTTP_ADDR=:8080

DATABASE_URL=postgres://echoapp:echoapp@localhost:5432/echoapp?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# JWT — generate a long random string for prod. Anything works locally.
JWT_SECRET=local-dev-secret-change-me
JWT_TTL=720h

# Paystack — get from your Paystack dashboard (Test mode for dev).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_KEY=

# Cooldown for raising sending limits. Production = 24h; dev can be short.
RISK_LIMIT_RAISE_COOLDOWN=30s
