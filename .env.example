ENV=local
LOG_LEVEL=debug
HTTP_ADDR=:8080

DATABASE_URL=postgres://echoapp:echoapp@localhost:5432/echoapp?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# JWT — generate a long random string for prod. Anything works locally.
JWT_SECRET=local-dev-secret-change-me
JWT_TTL=720h

# Paystack — get from your Paystack dashboard (Test mode for dev).
PAYSTACK_SECRET_KEY=sk_test_15208f5334b3a3574aa9f3cac92da2feb276578c
PAYSTACK_PUBLIC_KEY=pk_test_a4ed5d0d781692c0044f470cdda02ba73e0e23f2
PAYSTACK_WEBHOOK_KEY=

# Cooldown for raising sending limits. Production = 24h; dev can be short.
RISK_LIMIT_RAISE_COOLDOWN=30s

# Force-update floor. Clients below this version are blocked at startup.
# Only bump for security-critical releases.
MIN_SUPPORTED_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0

# KYC provider. "stub" passes any well-formed BVN; "youverify" does a real
# lookup. Get a sandbox key at https://app.youverify.co before switching.
KYC_PROVIDER=stub
YOUVERIFY_BASE_URL=https://api.sandbox.youverify.co
YOUVERIFY_API_KEY=

# Firebase Cloud Messaging. Leave empty for dev — push.Service no-ops
# without credentials. FCM_CREDENTIALS_FILE points at the service-account
# JSON (Firebase Console → Project Settings → Service accounts).
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
# FCM_CREDENTIALS_JSON= # inline alternative; takes precedence if set
